exports[`QuickRead (Evidence tab) — renders exactly as on the base, per branch > MSFT (mature reading, DEGENERATE cell, margin at high) 1`] = `"<section id="quickread" aria-label="Quick read"><div class="sechead"><h2>Quick read</h2><span class="k">Microsoft Corporation · mature, profitable, stable free cash flow · price as of 2026-09-04T21:00:00-04:00</span></div><hr><div class="atglance"><div><span class="lb">Bear</span><span class="fig">$265</span></div><div><span class="lb">Base</span><span class="fig">$510</span></div><div><span class="lb">Bull</span><span class="fig">$650</span></div><div class="cur"><span class="lb">Current price</span><span class="fig">$510.12</span></div></div><p class="striploc">64% of the way from bear to bull</p><div class="qitem"><span class="k">Main finding</span><p class="qlead">Today's price implies roughly 13.1% annual growth over ten years (17.6% for the next five, at the current margin and 8% discount rate). One or more reverse-DCF scenarios return no number at all (<b>DEGENERATE — TERMINAL EXCEEDS TOTAL VALUE</b>) rather than a misleading one — see <a href="#E">Section E</a> for which.</p></div><div class="qitem"><span class="k">Price vs scenarios</span><p class="t">Inside the authored bear-bull range, with the weighted value shown inside the range rather than as a headline (the bounds are scenario labels, not confidence bounds). <a href="#H">Section H</a></p></div><div class="qitem"><span class="k">What today's price requires</span><p class="t">17.6% revenue growth for five years at r = 8%, equivalent to 13.1% over ten. <a href="#E">Section E</a></p></div><div class="qitem"><span class="k">What supports the case</span><ul><li>Return on new capital of 20.9%, above every discount rate tested — <a href="#D">Section D</a></li><li>At least one reverse-DCF cell resolves to a usable growth figure rather than returning a state — <a href="#E">Section E</a></li></ul></div><div class="qitem"><span class="k">What worries Calboard</span><ul><li>Operating margin sits at or near its own ten-year high (<b>MARGIN AT HISTORICAL HIGH</b>), and the reverse-DCF grid is run from that level — <a href="#D">Section D</a></li><li>One or more reverse-DCF cells return <b>DEGENERATE — TERMINAL EXCEEDS TOTAL VALUE</b> rather than a number — <a href="#E">Section E</a></li></ul></div><div class="qitem"><span class="k">Biggest uncertainty</span><p class="t">Which margin level is the right base for the reverse-DCF grid — the current level or the ten-year median. The gap drives the whole grid. <a href="#D">Section D</a></p></div><div class="qitem"><span class="k">Strongest challenger point</span><p class="t">Findings from the independent challenger call appear in <a href="#I2">Section I2</a>, unreconciled with the analysis above, once that call completes.</p></div><div class="qitem"><span class="k">Data and model quality</span><p class="t"><b>Trust status PARTIAL</b></p><ul><li>Output(s) return <b>PRECONDITION FAILED</b> — see <a href="#D">Section D</a></li><li>Output(s) return <b>DEGENERATE — TERMINAL EXCEEDS TOTAL VALUE</b> — see <a href="#E">Section E</a></li><li>Output(s) return <b>INCOMPLETE</b> — see <a href="#E">Section E</a></li><li><b>MARGIN AT HISTORICAL HIGH</b> — operating margin.</li><li>One or more facts in <a href="#B">Section B</a> carry a non-default provenance marker (secondary source, AI-extracted, or unverified).</li></ul></div></section>"`;

exports[`QuickRead (Evidence tab) — renders exactly as on the base, per branch > MSFT, gate 0 refuses 1`] = `"<section id="quickread" aria-label="Quick read"><div class="sechead"><h2>Quick read</h2><span class="k">Microsoft Corporation · mature, profitable, stable free cash flow · price as of 2026-09-04T21:00:00-04:00</span></div><hr><div class="atglance"><div><span class="lb">Bear</span><span class="fig">$265</span></div><div><span class="lb">Base</span><span class="fig">$510</span></div><div><span class="lb">Bull</span><span class="fig">$650</span></div><div class="cur"><span class="lb">Current price</span><span class="fig">$510.12</span></div></div><p class="striploc">64% of the way from bear to bull</p><div class="qitem"><span class="k">Main finding</span><p class="qlead">Calboard cannot value Microsoft Corporation with this method — <b>UNSUPPORTED PROFILE — CLASSIFICATION UNAVAILABLE</b> (<a href="#C">Section C</a>).</p></div><div class="qitem"><span class="k">Price vs scenarios</span><p class="t">Every price-implied and scenario output is suppressed under this state — see <a href="#H">Section H</a>.</p></div><div class="qitem"><span class="k">What today's price requires</span><p class="t">Not shown — no valuation output survives this gate. See <a href="#C">Section C</a>.</p></div><div class="qitem"><span class="k">What supports the case</span><p class="t">Facts, and whatever multiples and history diagnostics remain arithmetically defined, are still shown — see <a href="#D">Section D</a>.</p></div><div class="qitem"><span class="k">What worries Calboard</span><p class="t">The gate refuses outright rather than producing a confident-looking answer from the wrong model — see <a href="#C">Section C</a>.</p></div><div class="qitem"><span class="k">Biggest uncertainty</span><p class="t">Whether the classification itself is right — see <a href="#C">Section C</a> for the exact test that fired.</p></div><div class="qitem"><span class="k">Strongest challenger point</span><p class="t">Findings from the independent challenger call appear in <a href="#I2">Section I2</a>, unreconciled with the analysis above, once that call completes.</p></div><div class="qitem"><span class="k">Data and model quality</span><p class="t"><b>Trust status PARTIAL</b></p><ul><li>Output(s) return <b>PRECONDITION FAILED</b> — see <a href="#D">Section D</a></li><li>Output(s) return <b>DEGENERATE — TERMINAL EXCEEDS TOTAL VALUE</b> — see <a href="#E">Section E</a></li><li>Output(s) return <b>INCOMPLETE</b> — see <a href="#E">Section E</a></li><li><b>MARGIN AT HISTORICAL HIGH</b> — operating margin.</li><li>One or more facts in <a href="#B">Section B</a> carry a non-default provenance marker (secondary source, AI-extracted, or unverified).</li></ul></div></section>"`;

exports[`QuickRead (Evidence tab) — renders exactly as on the base, per branch > MSFT, leverage precondition fails 1`] = `"<section id="quickread" aria-label="Quick read"><div class="sechead"><h2>Quick read</h2><span class="k">Microsoft Corporation · mature, profitable, stable free cash flow · price as of 2026-09-04T21:00:00-04:00</span></div><hr><div class="atglance"><div><span class="lb">Bear</span><span class="fig">$265</span></div><div><span class="lb">Base</span><span class="fig">$510</span></div><div><span class="lb">Bull</span><span class="fig">$650</span></div><div class="cur"><span class="lb">Current price</span><span class="fig">$510.12</span></div></div><p class="striploc">64% of the way from bear to bull</p><div class="qitem"><span class="k">Main finding</span><p class="qlead">The leverage precondition fails for Microsoft Corporation, so every rate-dependent output here is suppressed (<b>LEVERAGE UNSUPPORTED IN v1</b> — <a href="#C">Section C</a>).</p></div><div class="qitem"><span class="k">Price vs scenarios</span><p class="t">The fair-value range is suppressed under this state — see <a href="#H">Section H</a>.</p></div><div class="qitem"><span class="k">What today's price requires</span><p class="t">Not shown — the reverse-DCF grid, steady-state EV/PVGO, implied exit multiple and the fair-value range are all suppressed. See <a href="#E">Section E</a>.</p></div><div class="qitem"><span class="k">What supports the case</span><p class="t">Facts and whatever diagnostics do not depend on the levered structure remain shown — see <a href="#D">Section D</a>.</p></div><div class="qitem"><span class="k">What worries Calboard</span><p class="t">A capital structure this levered can no longer be treated as a straightforward unlevered claim — see <a href="#C">Section C</a>.</p></div><div class="qitem"><span class="k">Biggest uncertainty</span><p class="t">The net debt ratio itself and whether it is likely to change — see <a href="#C">Section C</a>.</p></div><div class="qitem"><span class="k">Strongest challenger point</span><p class="t">Findings from the independent challenger call appear in <a href="#I2">Section I2</a>, unreconciled with the analysis above, once that call completes.</p></div><div class="qitem"><span class="k">Data and model quality</span><p class="t"><b>Trust status PARTIAL</b></p><ul><li>Output(s) return <b>PRECONDITION FAILED</b> — see <a href="#D">Section D</a></li><li>Output(s) return <b>DEGENERATE — TERMINAL EXCEEDS TOTAL VALUE</b> — see <a href="#E">Section E</a></li><li>Output(s) return <b>INCOMPLETE</b> — see <a href="#E">Section E</a></li><li><b>MARGIN AT HISTORICAL HIGH</b> — operating margin.</li><li>One or more facts in <a href="#B">Section B</a> carry a non-default provenance marker (secondary source, AI-extracted, or unverified).</li></ul></div></section>"`;

