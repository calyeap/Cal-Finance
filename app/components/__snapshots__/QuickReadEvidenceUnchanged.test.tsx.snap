exports[`QuickRead (Evidence tab) — renders exactly as on the base, per branch > OKLO (pre-revenue distribution) 1`] = `"<section id="quickread" aria-label="Quick read"><div class="sechead"><h2>Quick read</h2><span class="k">Oklo Inc. · pre-revenue / unprofitable · price as of 2026-09-04T16:00:00-04:00</span></div><hr><div class="atglance" style="grid-template-columns: repeat(3, minmax(0, 1fr));"><div><span class="lb">Failure — cash floor</span><span class="fig">$3.10</span></div><div><span class="lb">Success as described</span><span class="fig">$31.00 - $48.00</span></div><div class="cur"><span class="lb">Current price</span><span class="fig">$14.50</span></div></div><p class="striploc">25% of the way from failure to success</p><div class="qitem"><span class="k">Main finding</span><p class="qlead">On one or more of the modelled ways Oklo Inc. could succeed, shareholders would end up with less than if it simply held its cash (<b>THIS SUCCESS IS WORTH LESS THAN FAILURE</b>) — see <a href="#D">Section D</a> for which.</p></div><div class="qitem"><span class="k">Price vs scenarios</span><p class="t">Not a bear-bull range. The outcomes are separate worlds, so the output is a distribution: failure $3.10, success as commonly described $31.00-$48.00. <a href="#H">Section H</a></p></div><div class="qitem"><span class="k">What today's price requires</span><p class="t">Success as today's price requires is $14.50 per share. <a href="#H">Section H</a></p></div><div class="qitem"><span class="k">What supports the case</span><ul><li>A cash floor of $3.10 per share that does not depend on Oklo Inc.'s operations succeeding — <a href="#H">Section H</a></li><li>At least one modelled success clears the cash floor by a wide margin — <a href="#D">Section D</a></li></ul></div><div class="qitem"><span class="k">What worries Calboard</span><ul><li>One or more success definitions return <b>THIS SUCCESS IS WORTH LESS THAN FAILURE</b> — a finding, not an error. <a href="#D">Section D</a></li><li>The levered cost-of-equity cap binds on one or more success definitions (<b>RATE CAPPED — VALUE IS AN UPPER BOUND</b>), so those values are upper bounds — <a href="#D">Section D</a></li></ul></div><div class="qitem"><span class="k">Biggest uncertainty</span><p class="t">The capacity ramp shape used in the funding stack — back-loaded versus steady moves the same success case's value. <a href="#D">Section D</a></p></div><div class="qitem"><span class="k">Strongest challenger point</span><p class="t">Findings from the independent challenger call appear in <a href="#I2">Section I2</a>, unreconciled with the analysis above, once that call completes.</p></div><div class="qitem"><span class="k">Data and model quality</span><p class="t"><b>Trust status PARTIAL</b></p><ul><li>Output(s) return <b>HISTORY INSUFFICIENT</b> — see <a href="#D">Section D</a></li><li>Output(s) return <b>PRECONDITION FAILED</b> — see <a href="#D">Section D</a></li><li>Output(s) return <b>INCOMPLETE</b> — see <a href="#E">Section E</a></li><li>Output(s) return <b>NO SOLUTION IN RANGE</b> — see <a href="#G">Section G</a></li><li><b>MARGIN AT HISTORICAL HIGH</b> — operating margin.</li><li>One or more facts in <a href="#B">Section B</a> carry a non-default provenance marker (secondary source, AI-extracted, or unverified).</li></ul></div></section>"`;

exports[`QuickRead (Evidence tab) — renders exactly as on the base, per branch > OKLO, acquired cash basis not established 1`] = `"<section id="quickread" aria-label="Quick read"><div class="sechead"><h2>Quick read</h2><span class="k">Oklo Inc. · pre-revenue / unprofitable · price as of 2026-09-04T16:00:00-04:00</span></div><hr><div class="atglance" style="grid-template-columns: repeat(3, minmax(0, 1fr));"><div><span class="lb">Failure — cash floor</span><span class="fig">INCOMPLETE</span></div><div><span class="lb">Success as described</span><span class="fig">—</span></div><div class="cur"><span class="lb">Current price</span><span class="fig">$14.50</span></div></div><p class="striploc">25% of the way from failure to success</p><div class="qitem"><span class="k">Main finding</span><p class="qlead">Calboard cannot show a fair-value distribution for Oklo Inc. on this run — <b>INCOMPLETE</b> (<a href="#D">Section D</a>).</p></div><div class="qitem"><span class="k">Price vs scenarios</span><p class="t">missing REQUIRED input: acquired cash balance, shares outstanding used by the acquired run <a href="#D">Section D</a></p></div><div class="qitem"><span class="k">What today's price requires</span><p class="t">Not shown — no fair-value distribution survives this state. See <a href="#D">Section D</a>.</p></div><div class="qitem"><span class="k">What supports the case</span><p class="t">Whichever success definitions and funding-stack figures remain independently computable are still shown — see <a href="#D">Section D</a>.</p></div><div class="qitem"><span class="k">What worries Calboard</span><p class="t">The acquired cash-per-share basis is not established, so the failure floor and any success weight built on it are withheld rather than shown on an invented basis — see <a href="#D">Section D</a>.</p></div><div class="qitem"><span class="k">Biggest uncertainty</span><p class="t">Whether a later run can acquire the missing cash, share or burn evidence this basis needs — see <a href="#D">Section D</a>.</p></div><div class="qitem"><span class="k">Strongest challenger point</span><p class="t">Findings from the independent challenger call appear in <a href="#I2">Section I2</a>, unreconciled with the analysis above, once that call completes.</p></div><div class="qitem"><span class="k">Data and model quality</span><p class="t"><b>Trust status UNUSABLE</b></p><ul><li>Output(s) return <b>HISTORY INSUFFICIENT</b> — see <a href="#D">Section D</a></li><li>Output(s) return <b>PRECONDITION FAILED</b> — see <a href="#D">Section D</a></li><li>Output(s) return <b>INCOMPLETE</b> — see <a href="#E">Section E</a></li><li>Output(s) return <b>NO SOLUTION IN RANGE</b> — see <a href="#G">Section G</a></li><li><b>MARGIN AT HISTORICAL HIGH</b> — operating margin.</li><li>One or more facts in <a href="#B">Section B</a> carry a non-default provenance marker (secondary source, AI-extracted, or unverified).</li></ul></div></section>"`;

